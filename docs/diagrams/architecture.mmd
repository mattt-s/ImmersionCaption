flowchart LR
    accTitle: ImmersionCaption caption-only architecture
    accDescr: A caption session applies domain rules to local Apple speech results and publishes recognized text directly. Core Audio captures system audio only. No inference service or network backend is used.
    subgraph App["ImmersionCaption.app"]
        Container["AppContainer<br/>Composition root<br/>Deferred overlay creation"]
        Views["SwiftUI controls<br/>Settings + history export"]
        Overlay["Floating overlay<br/>AppKit panel + SwiftUI<br/>Recognized text only"]
        Session["CaptionSession · MainActor<br/>Lifecycle + direct publication<br/>History: latest 300 captions"]
        Core["CaptionCore · Foundation<br/>Caption + SessionState<br/>TranscriptSegmenter<br/>TranscriptCursor + SpeechSegment"]
        Settings["AppSettings<br/>Font + opacity + position"]
        Capture["SystemAudioCapturing<br/>CoreAudioTapCapture<br/>Owning PCM sample buffers"]
        Speech["SpeechRecognizing<br/>AppleSpeechRecognizer<br/>Cumulative text + timings"]
    end
    Audio["Core Audio process tap<br/>System Audio Recording permission"]
    Native["Apple Speech framework<br/>OS-managed local Mandarin assets"]
    Defaults[("UserDefaults<br/>Appearance preferences")]
    Container -->|"assembles"| Session
    Container -->|"defers creation"| Overlay
    Views -->|"controls / observes"| Session
    Overlay -->|"observes text"| Session
    Views -->|"binds"| Settings
    Overlay -->|"appearance"| Settings
    Settings --> Defaults
    Session -->|"domain rules"| Core
    Session -->|"starts / stops"| Capture
    Session -->|"starts / stops"| Speech
    Capture -->|"native API"| Audio
    Capture -->|"system audio"| Speech
    Speech -->|"on-device API"| Native
    Speech -->|"recognized events"| Session
    classDef application fill:#e8f5f1,stroke:#23836d,color:#153e35
    classDef presentation fill:#eaf2ff,stroke:#3b67b1,color:#172b4d
    classDef domain fill:#f2ecfc,stroke:#815bb3,color:#382254
    classDef adapter fill:#fff4df,stroke:#b9822d,color:#513b16
    class Session,Container application
    class Views,Overlay presentation
    class Core domain
    class Settings,Capture,Speech adapter
