flowchart LR
    accTitle: ImmersionCaption multilingual rolling-caption architecture
    accDescr: A selected spoken locale configures local Apple Speech. Cumulative partials replace request snapshots in a bounded domain buffer. The overlay wraps and scrolls while history is updated in place. No translation or external inference service is used.
    subgraph App["ImmersionCaption.app"]
        Container["AppContainer<br/>Language discovery + injection<br/>Deferred overlay creation"]
        Controls["Main window + menu bar<br/>Spoken-language picker<br/>Start / pause / resume / stop"]
        Overlay["Rolling caption overlay<br/>Immediate revisable text<br/>Wrap + scroll + Follow live<br/>Native drag handle + lock control"]
        Lock["Small interactive child panel<br/>Lock / unlock<br/>Moves and hides with caption panel"]
        History["History + text export<br/>Latest 300 request snapshots"]
        Session["CaptionSession · MainActor<br/>Locale + lifecycle + visibility<br/>Independent display/history buffers"]
        Core["CaptionCore<br/>Caption + LiveTranscript + SessionState<br/>SavedOverlayPosition + OverlayGeometry"]
        Settings["AppSettings<br/>Language + appearance<br/>Click-through + preview<br/>Preset / custom anchor + lock state"]
        Activity["AudioActivityMonitoring<br/>PCMActivityMonitor<br/>Passive last-audible timestamp"]
        Capture["SystemAudioCapturing<br/>CoreAudioTapCapture"]
        Speech["SpeechRecognizing<br/>AppleSpeechRecognizer<br/>Selected local locale"]
    end
    Audio["Core Audio process tap<br/>System Audio Recording permission"]
    Native["Apple Speech framework<br/>Supported locale catalog<br/>OS-managed language assets"]
    Defaults[("UserDefaults")]
    Container -->|"assembles"| Session
    Container -->|"defers creation"| Overlay
    Controls -->|"controls / observes"| Session
    Controls -->|"selection"| Settings
    Overlay -->|"observes"| Session
    History -->|"observes"| Session
    Overlay -->|"appearance / saved position"| Settings
    Overlay -->|"validate / restore / constrain"| Core
    Overlay ---|"attached window"| Lock
    Lock -->|"toggle lock"| Settings
    Settings --> Defaults
    Session -->|"snapshot rules"| Core
    Session -->|"start / stop"| Capture
    Session -->|"locale + start / stop"| Speech
    Capture -->|"observe PCM in receiver"| Activity
    Activity -->|"unchanged audio"| Speech
    Session -->|"poll activity / hide panel"| Activity
    Capture -->|"native API"| Audio
    Speech -->|"local API + catalog"| Native
    Speech -->|"partial / final text"| Session
