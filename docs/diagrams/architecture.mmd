    classDef presentation fill:#eaf2ff,stroke:#3b67b1,color:#172b4d
    classDef domain fill:#f2ecfc,stroke:#815bb3,color:#382254
    classDef adapter fill:#fff4df,stroke:#b9822d,color:#513b16
