flowchart TD
    accTitle: Immediate revisable caption display policy
    accDescr: Select a locally supported language while paused or stopped. Each partial immediately replaces its request snapshot. Finality updates metadata rather than gating display. Recent text wraps and scrolls; history and display buffers are bounded.
    Select["Select spoken language<br/>Pause/stop before changing"]
    Ready{"Recognizer available<br/>and supports on-device?"}
    Error["Show language setup error<br/>No cloud fallback / no capture"]
    Start["Start system-audio capture<br/>Require local recognition"]
    Event["Current request partial or final<br/>Full current text + request ID"]
    Current{"Current session/request<br/>and running?"}
    Ignore["Ignore obsolete event"]
    Update["Replace existing request snapshot<br/>or append a new request block<br/>Empty revision retracts a draft"]
    Changed{"Text or finality changed?"}
    Duplicate["No extra row or timer reset"]
    Publish["Update immediately<br/>History: newest 300 blocks<br/>Display: newest 3 current-run blocks"]
    Scroll["Wrap at selected font size<br/>Follow live: scroll to newest text<br/>Follow off: manual review"]
    Idle["12 seconds without changed text:<br/>hide unless Keep Onscreen<br/>Pause/stop clears live display"]
    Note["No punctuation or isFinal display gate<br/>Revisions keep identity and first-seen time<br/>Finality marks the same entry final"]
    Select --> Ready
    Ready -->|"No"| Error
    Ready -->|"Yes"| Start --> Event --> Current
    Current -->|"No"| Ignore
    Current -->|"Yes"| Update --> Changed
    Changed -->|"No"| Duplicate
    Changed -->|"Yes"| Publish --> Scroll --> Idle
    Update -.-> Note
    classDef input fill:#eaf2ff,stroke:#3b67b1,color:#172b4d
    classDef policy fill:#e8f5f1,stroke:#23836d,color:#153e35
    classDef output fill:#f2ecfc,stroke:#815bb3,color:#382254
    classDef warning fill:#fff1df,stroke:#b9822d,color:#513b16
    class Select,Ready,Start,Event input
    class Current,Update,Changed policy
    class Publish,Scroll,Idle output
    class Error,Note warning
